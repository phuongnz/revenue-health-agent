# Configuration keys, read from the environment by app/config.py. Copy to .env only on a
# machine of your own; .env is ignored by git and must never be committed. With every
# value empty and SAMPLE_MODE=true the agents run on cached inputs with no network.

# Zetaris REST API (read-only use: the Retriever allowlists SELECT, WITH, SHOW, DESCRIBE)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# 30-60 seconds per statement
ZETARIS_TIMEOUT_S=45

# Meterless Nightshift, the local OpenAI-compatible gateway (inside Docker:
# http://host.docker.internal:8088/v1)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# Default lane for the agents; a routing mode such as meterless/auto is ignored here and
# the Lightning lane pinned instead, so every receipt names a Nemotron model
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Lane for the Evaluator
METERLESS_EVALUATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# 30-90 seconds per model request
METERLESS_TIMEOUT_S=60

SAMPLE_MODE=false
# Whole run 300-600 seconds; one engine step (company and concept) 60-180 seconds
RUN_TIMEOUT_S=480
STEP_TIMEOUT_S=180
LOG_LEVEL=INFO
LOG_DIR=logs
PORT=8000
